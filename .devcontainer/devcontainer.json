{
  "name": "Acoustic Sim",
  "dockerComposeFile": "../docker-compose.yml",
  "service": "dev",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.pylint"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "explorer.excludeGitIgnore": false,
        "files.exclude": {
          "**/.git": false
        }
      }
    }
  },
  "postCreateCommand": "python -m pip install -e '.[cuda,dev]' && git config --global --add safe.directory /workspace && git config --global core.autocrlf input",
  "remoteUser": "devuser",
  "containerUser": "devuser",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "workspaceFolder": "/workspace",
  "overrideCommand": true
}
